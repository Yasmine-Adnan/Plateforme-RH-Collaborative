<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Framework de test (équivalent de JUnit) -->
    <PackageReference Include="JunitXml.TestLogger" Version="8.1.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Simulation des dépendances (équivalent de Mockito) -->
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- Mesure de la couverture de code (équivalent de JaCoCo) -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le projet testé : ton application -->
    <ProjectReference Include="..\PlateformeRHCollaborative.Web.csproj" />
  </ItemGroup>

</Project>
